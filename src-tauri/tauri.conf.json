{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leaf",
  "version": "0.1.0",
  "identifier": "dev.leaf.console",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "轻叶 · 项目任务控制台",
        "width": 1100,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "DeveloperTool",
    "shortDescription": "轻叶 · 项目任务控制台",
    "longDescription": "轻叶（Leaf）— 本机轻量计划闭环任务控制台：生成→核对→拆分→并行→巡检。"
  }
}
