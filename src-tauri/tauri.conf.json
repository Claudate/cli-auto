{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCO",
  "version": "0.1.0",
  "identifier": "dev.cco.orchestrator",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cco · CLI Orchestrator",
        "width": 1100,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "DeveloperTool",
    "shortDescription": "CLI Orchestrator desktop",
    "longDescription": "Native macOS desktop for cco — plan-driven multi-CLI agent orchestration."
  }
}
